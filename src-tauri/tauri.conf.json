{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "網路健檢",
  "version": "0.1.0",
  "identifier": "tw.lin.internettest",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "網路健檢",
        "width": 1000,
        "height": 760,
        "minWidth": 880,
        "minHeight": 660,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["TradChinese"],
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {}
}
